! ––– MASTER script ––– !
! Runs before every other script, so anything defined here is visible
! everywhere. Renaming `gDetailFactor` must therefore reach all scripts.

gDetailFactor = 1
if iDetailLevel > 1 then gDetailFactor = 2

! Leading underscore marks a name as private to this script by convention:
! GDL still shares it, but it is not offered as a completion elsewhere.
_scratchAngle = 45

! The master runs ahead of every other script, so an array declared here is
! declared for all of them — which is why the undeclared-array check reads it.
dim gSegmentLengths[]

! GDL has no enum, so a named value and its caption are written as two ordinary
! assignments — the shape `gdl/literals.ts` reads back. Type `iMarkerDir = ` in
! any script of this part and the four names below are offered, each with the
! caption resolved from `stMarkerDir`.
DIR_PERPENDICULAR	= 1
DIR_ALIGNED			= 2
DIR_HORIZONTAL		= 3
DIR_VERTICAL		= 4

dim stMarkerDir[4]
stMarkerDir[DIR_PERPENDICULAR]	= "Perpendicular to the marker axis"
stMarkerDir[DIR_ALIGNED]		= "Aligned with the marker axis"
stMarkerDir[DIR_HORIZONTAL]		= "Horizontal"
stMarkerDir[DIR_VERTICAL]		= "Vertical"
